# Copy to .env.telegram in the repository root. This real file is gitignored.
# Create the bot via @BotFather. Never commit or paste its token into chat.
TELEGRAM_BOT_TOKEN=
# Numeric ID of a PRIVATE staff chat or a restricted staff group.
# A private-chat recipient must first start the bot; a group must contain the bot.
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_DATABASE=data/telegram/bot.sqlite3
